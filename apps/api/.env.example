# Database for this environment. Apply migrations with pnpm db:migrate.
DATABASE_URL=
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Keys for Clerk app app_3JY7ZSznQtcBkbaiIhwW15Ggw2p.
# Enable Google only, allow /sso-callback and avoid required extra signup fields.
CLERK_SECRET_KEY=

# Private R2 bucket. Configure bucket CORS for the web origins above:
# methods GET, HEAD, PUT; allowed headers Content-Type; expose ETag.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=imprint

# The API and Trigger worker need these variables.
# After pnpm db:migrate, run pnpm dev for the web, API and Trigger worker.
# Trigger may ask you to authorize the CLI once on first use.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Public Instagram import through apify/instagram-scraper. No Instagram login.
APIFY_TOKEN=
INSTAGRAM_POST_LIMIT=1000

# Required in production. Optional locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Axiom receives structured stdout through the Vercel log drain.
SENTRY_DSN=
