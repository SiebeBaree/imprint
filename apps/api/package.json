{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
        "start": "tsx src/server.ts",
        "typecheck": "tsc",
        "lint": "oxlint --deny-warnings",
        "test": "vitest run",
        "jobs:dev": "trigger dev --env-file .env",
        "jobs:deploy": "trigger deploy"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1135.0",
        "@aws-sdk/s3-request-presigner": "^3.1135.0",
        "@clerk/backend": "^3.18.1",
        "@fastify/cors": "^11.0.0",
        "@fastify/helmet": "^13.0.0",
        "@google/genai": "^2.23.0",
        "@neondatabase/serverless": "^1.1.0",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@repo/contracts": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/env": "workspace:*",
        "@repo/logger": "workspace:*",
        "@sentry/node": "^10.70.0",
        "@trigger.dev/sdk": "^4.6.3",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.2",
        "ai": "^7.0.106",
        "apify-client": "^2.25.0",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.0.0",
        "fastify-plugin": "^6.0.0",
        "fastify-type-provider-zod": "^7.0.0",
        "openai": "^7.18.0",
        "pdfjs-dist": "^6.3.289",
        "pino": "^10.3.1",
        "sharp": "^0.35.4",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.5",
        "@repo/oxlint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^26.2.0",
        "trigger.dev": "^4.6.3",
        "tsx": "^4.20.0",
        "typescript": "^5.9.3",
        "undici-types": "~8.3.0",
        "vitest": "catalog:"
    }
}
